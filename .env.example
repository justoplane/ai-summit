# Durf Dungeon LLC
# Copy to .env.local and fill in. .env.local is gitignored.

# Password for the host page login. Only thing standing between the internet and the QR code.
APP_PASSWORD=change-me

# OpenAI. Any vision-capable model that supports structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase. Server-side only; never exposed to the browser.
# Leave both blank to use the in-memory dev store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
